# Supabase（データベース・画像の保存先は、これだけ）
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# メッセージの暗号化キー（32バイトの乱数を base64 にしたもの。例: openssl rand -base64 32）
MESSAGE_ENCRYPTION_KEY=

# 通知（Web Push）の鍵
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# 管理者パネルのパスワード
ADMIN_PASSWORD=

PORT=3000
